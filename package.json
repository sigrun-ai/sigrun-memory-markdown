{
	"name": "@sigrun/memory-markdown",
	"version": "0.2.3",
	"description": "Markdown long-term memory for sigrun: per-user USER.md/MEMORY.md, the live long-term-memory section, and the memory curation target",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/memory-markdown && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.3.0 || 1.4.0",
		"@earendil-works/pi-ai": "1.3.0 || 1.4.0",
		"@earendil-works/pi-durable": "1.3.0 || 1.4.0"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@sigrun/sigrun": "file:../sigrun",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-memory-markdown.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-memory-markdown/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-memory-markdown#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
